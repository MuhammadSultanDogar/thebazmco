# Copy to .env.local for local dev — do NOT commit real values to git.
# Easiest: run `vercel env pull` after linking the project.

# Manager login (change these in production!)
MANAGER_USERNAME=
MANAGER_PASSWORD=

# Required in production — random string, e.g. openssl rand -base64 32
MANAGER_SESSION_SECRET=

# Upstash Redis / Vercel KV (added automatically via Vercel Storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Or Vercel KV env var names:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
