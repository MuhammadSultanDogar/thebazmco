# Copy to .env.local for local dev — do NOT commit real values to git.
# Easiest: run `vercel env pull` after linking the project.

# Upstash Redis (added automatically when you connect via Vercel Storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Or Vercel KV (same Upstash backend, different env var names)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
